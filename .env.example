# Copy this file to .env and set credentials for your PostgreSQL server.
DATABASE_URL=postgresql+psycopg2://anime_app:replace-with-your-password@127.0.0.1:5432/anime_db
ANIME_API_BASE_URL=https://api.tenrai.org/v1
ANIME_API_FALLBACK_BASE_URL=https://api.jikan.moe/v4
ANIME_STREAMING_API_BASE_URL=https://api.jikan.moe/v4
# Generate a long random secret and set the same value in Render before using
# the private analytics endpoint. Do not commit the real value.
ADMIN_ANALYTICS_TOKEN=replace-with-a-long-random-secret
# Set true in Render so the anonymous visitor cookie is HTTPS-only. Local
# development may use false when running the Flask server over plain HTTP.
ANALYTICS_COOKIE_SECURE=false
